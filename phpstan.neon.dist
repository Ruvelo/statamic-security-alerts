includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
        - routes
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # The core's exceptions don't extend SecurityAlertsException, and SecurityAlerts::check() doesn't declare them.
        -
            identifier: catch.neverThrown
            message: '#SecurityAdvisoriesException is never thrown#'
            path: src/Http/Controllers/SecurityAlertsController.php
